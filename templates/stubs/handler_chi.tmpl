	respItems := make([]types.{{.EntityPascal}}Response, 0, len(items))
	for _, item := range items {
		respItems = append(respItems, types.To{{.EntityPascal}}Response(item))
	}

	totalPages := int((total + int64(pageSize) - 1) / int64(pageSize))
