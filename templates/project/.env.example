APP_NAME={{.ProjectName}}
APP_ENV=development
APP_PORT=8080
APP_HOST=0.0.0.0
APP_LOG_LEVEL=debug

# Database configuration ({{.Database}})
{{- if eq .Database "sqlite"}}
# DB_NAME is the SQLite database file path
DB_NAME={{.DBName}}.db
{{- else}}
DB_HOST=localhost
DB_PORT={{.DBDefaultPort}}
DB_USER={{.DBDefaultUser}}
DB_PASSWORD={{if eq .Database "mysql"}}root{{else}}postgres{{end}}
DB_NAME={{.DBName}}
{{- if eq .Database "postgres"}}
DB_SSLMODE=disable
{{- end}}
{{- end}}
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_TIMEOUT=5s
DB_CONN_MAX_LIFETIME=30m

# JWT Authentication
JWT_SECRET=super-secret-key-change-in-production
JWT_EXPIRATION_HOURS=24
