APP_NAME={{.ProjectName}}
APP_ENV=development
APP_PORT=8080
APP_HOST=0.0.0.0
APP_LOG_LEVEL=debug

# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME={{.DBName}}
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_TIMEOUT=5s
DB_CONN_MAX_LIFETIME=30m

# JWT Authentication
JWT_SECRET=super-secret-key-change-in-production
JWT_EXPIRATION_HOURS=24
