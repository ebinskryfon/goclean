package database

import (
	"context"
	"database/sql"
	"fmt"
	"os"
	"time"

	"{{.ModuleName}}/config"
{{- if eq .Database "mysql"}}
	"gorm.io/driver/mysql"
{{- else if eq .Database "sqlite"}}
	"github.com/glebarez/sqlite"
{{- else}}
	"gorm.io/driver/postgres"
{{- end}}
	"gorm.io/gorm"
	"gorm.io/gorm/logger"
)

// DefaultConnTimeout is the default bounded timeout for verifying database connectivity.
const DefaultConnTimeout = 5 * time.Second

// Connect initializes a GORM {{if eq .Database "mysql"}}MySQL{{else if eq .Database "sqlite"}}SQLite{{else}}PostgreSQL{{end}} connection pool and verifies database reachability.
func Connect(cfg config.DatabaseConfig) (*gorm.DB, error) {
	dsn := cfg.DSN()

	gormConfig := &gorm.Config{
		Logger: logger.Default.LogMode(logger.Silent),
	}

	db, err := gorm.Open({{if eq .Database "mysql"}}mysql{{else if eq .Database "sqlite"}}sqlite{{else}}postgres{{end}}.Open(dsn), gormConfig)
	if err != nil {
		return nil, fmt.Errorf("failed to open database: %w", err)
	}

	sqlDB, err := db.DB()
	if err != nil {
		return nil, fmt.Errorf("failed to retrieve sql.DB from gorm: %w", err)
	}

	configureConnectionPool(sqlDB, cfg)
{{- if eq .Database "sqlite"}}
	// SQLite allows a single writer; one connection avoids "database is locked" errors.
	sqlDB.SetMaxOpenConns(1)
{{- end}}

	timeout := cfg.ConnTimeout
	if timeout <= 0 {
		timeout = DefaultConnTimeout
	}

	ctx, cancel := context.WithTimeout(context.Background(), timeout)
	defer cancel()

	if err := sqlDB.PingContext(ctx); err != nil {
		_ = sqlDB.Close()
		return nil, fmt.Errorf("ping failed: %w", err)
	}

	return db, nil
}

// FailFast logs database unreachable message and exits with status 1.
func FailFast(err error) {
	fmt.Fprintf(os.Stderr, "database unreachable: %v\n", err)
	os.Exit(1)
}

func configureConnectionPool(sqlDB *sql.DB, cfg config.DatabaseConfig) {
	if cfg.MaxOpenConns > 0 {
		sqlDB.SetMaxOpenConns(cfg.MaxOpenConns)
	}
	if cfg.MaxIdleConns > 0 {
		sqlDB.SetMaxIdleConns(cfg.MaxIdleConns)
	}
	if cfg.ConnMaxLifetime > 0 {
		sqlDB.SetConnMaxLifetime(cfg.ConnMaxLifetime)
	}
}
