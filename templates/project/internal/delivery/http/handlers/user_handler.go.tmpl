{{- if eq .Router "chi"}}
package handlers

import (
	"errors"
	"net/http"

	"github.com/go-chi/chi/v5"
	"github.com/google/uuid"
	domainerrors "{{.ModuleName}}/internal/domain/errors"
	"{{.ModuleName}}/internal/delivery/http/response"
	"{{.ModuleName}}/internal/types"
	usecase "{{.ModuleName}}/internal/usecase/interface"
)

type UserHandler struct {
	userUsecase usecase.UserUsecase
}

func NewUserHandler(userUsecase usecase.UserUsecase) *UserHandler {
	return &UserHandler{userUsecase: userUsecase}
}

func (h *UserHandler) Register(w http.ResponseWriter, r *http.Request) {
	var req types.RegisterUserRequest
	if err := response.Bind(r, &req); err != nil {
		response.BadRequest(w, err.Error())
		return
	}

	user, err := h.userUsecase.Register(r.Context(), types.RegisterUserInput{
		Name:     req.Name,
		Email:    req.Email,
		Password: req.Password,
	})
	if err != nil {
		if errors.Is(err, domainerrors.ErrConflict) {
			response.Conflict(w, "a user with this email already exists")
			return
		}
		response.Internal(w, "failed to create user")
		return
	}

	response.Created(w, types.ToUserResponse(user))
}

func (h *UserHandler) GetByID(w http.ResponseWriter, r *http.Request) {
	id, err := uuid.Parse(chi.URLParam(r, "id"))
	if err != nil {
		response.BadRequest(w, "invalid uuid format")
		return
	}

	user, err := h.userUsecase.GetByID(r.Context(), id)
	if err != nil {
		if errors.Is(err, domainerrors.ErrNotFound) {
			response.NotFound(w, "user not found")
			return
		}
		response.Internal(w, "failed to retrieve user")
		return
	}

	response.Success(w, types.ToUserResponse(user))
}

func (h *UserHandler) List(w http.ResponseWriter, r *http.Request) {
	page := response.QueryInt(r, "page", 1)
	pageSize := response.QueryInt(r, "page_size", 20)

	users, total, err := h.userUsecase.List(r.Context(), page, pageSize)
	if err != nil {
		response.Internal(w, "failed to list users")
		return
	}

	items := make([]types.UserResponse, 0, len(users))
	for _, u := range users {
		items = append(items, types.ToUserResponse(u))
	}

	totalPages := int((total + int64(pageSize) - 1) / int64(pageSize))
	response.Paginated(w, items, response.Meta{
		Page:       page,
		PageSize:   pageSize,
		TotalItems: total,
		TotalPages: totalPages,
	})
}
